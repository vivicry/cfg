// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "autoscroll_on_clicks": true,
  "relative_line_numbers": "disabled",
  "gutter": {
    "line_numbers": true
  },
  "image_viewer": {
    "unit": "binary"
  },
  "inlay_hints": {
    "show_value_hints": false,
    "show_type_hints": false,
    "show_parameter_hints": false,
    "show_other_hints": false,
  },
  "terminal": {
    "minimum_contrast": 0.0,
    "copy_on_select": true,
    "env" : {
      "RUST_BACKTRACE": "1",
    },
  },
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_hidden": false,
    "hide_root": true,
    "auto_fold_dirs": false,
    "hide_gitignore": false,
  },
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "tabs": {
    "show_close_button": "hidden",
    "show_diagnostics": "off",
    "file_icons": false,
    "git_status": true,
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show": true,
  },
  "status_bar": {
    "active_file": true,
    "position": "top",
    "show": true,
  },
  "search": {
    "regex": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "colorize_brackets": true,
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware",
    "active_line_width": 2,
  },
  "toolbar": {
    "code_actions": true,
  },
  "minimap": {
    "thumb_border": "none",
    "show": "auto",
  },
  "excerpt_context_lines": 4,
  "expand_excerpt_lines": 9,
  "double_click_in_multibuffer": "open",
  "restore_on_startup": "last_session",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "format_on_save": "off",
  "ui_font_family": "ComicShannsMono Nerd Font Mono",
  "buffer_font_family": "ComicShannsMono Nerd Font Mono",
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": ["-compile-commands-dir=build"],
        "ignore_system_version": false,
        "enable_auto_updates": false,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "cmake": {
      "binary": {
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "zls": {
      "binary": {
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "lemminx": {
      "binary": {
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "lua-language-server": {
      "binary": {
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "json-language-server": {
      "binary": {
        "allow_binary_download": false
      },
      "enable_lsp_tasks": true
    },
    "rust-analyzer": {
      "binary": {
        "allow_binary_download": true,
      },
      "initialization_options": {
        "imports": {
          "granularity": {
            "group": "module",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "base_keymap": "SublimeText",
  "icon_theme": "Gram (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Rosé Pine Dawn",
    "dark": "Modus Vivendi",
  },
}
